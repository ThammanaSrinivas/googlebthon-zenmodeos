{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.guardrails/gr hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.guardrails/gr hook pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.guardrails/gr hook post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.guardrails/gr hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.guardrails/gr check)",
      "Bash(.guardrails/gr check *)",
      "Bash(.guardrails/gr explain)",
      "Bash(.guardrails/gr explain *)",
      "Bash(.guardrails/gr list)",
      "Bash(.guardrails/gr test)",
      "Bash(.guardrails/gr doctor)",
      "Bash(.guardrails/gr context)",
      "Bash(./.guardrails/gr check)",
      "Bash(./.guardrails/gr check *)",
      "Bash(./.guardrails/gr explain)",
      "Bash(./.guardrails/gr explain *)",
      "Bash(./.guardrails/gr list)",
      "Bash(./.guardrails/gr test)",
      "Bash(./.guardrails/gr doctor)",
      "Bash(./.guardrails/gr context)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)"
    ]
  }
}
